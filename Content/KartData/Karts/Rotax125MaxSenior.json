    "egt": { "idle": 250.0, "full": 620.0, "perLean": 1200.0, "perRich": 800.0, "timeConstant": 1.0 } // full: AiM guide 550-650 degC
  },

  // Mechanical damage (KartDamage.h). ALL ASSUMPTIONS, calibrated so clean laps over the kerbs do no damage
  // (Tests/DamageTests.cpp) and a ~5 m/s hit bends parts by about a degree.
  "damage": {
    "contactForce": 9000.0,           // N kart-kart force above which parts bend
    "sidepodForce": 5500.0,           // N side impact that knocks a sidepod loose (visual)
    "bumperForce": 6500.0,            // N rear impact that pushes the rear bumper in (visual)
    "fairingForce": 4500.0,           // N rearward on the nose that releases the CIK front fairing kit
    "toePerImpulse": 0.0012,          // deg toe per N s of front-corner impulse above contactForce
    "axleBendPerImpulse": 0.0015,    // deg axle bend per N s of rear impulse above contactForce
    "radiatorLeakPerImpulse": 4.0e-5, // coolant fraction lost per s, per N s of radiator-side impulse
    "radiatorSide": 1.0,
    "wheelLoadFront": 6000.0,          // N front tyre load spike that bends a steering arm
    "wheelLoadRear": 8000.0,           // N rear tyre load spike that bends the axle
    "loadToePerKn": 0.2,
    "loadBendPerKn": 0.15,
    "maxToe": 2.5,
    "maxAxleBend": 3.0,
    "axleDragPerDeg": 3.0,            // Nm axle friction per deg of bend
    "chainOffImpulse": 350.0,         // N s (filtered, above contactForce) single rear hit that throws the chain: ~25 km/h closing
    "chainOffBend": 2.5,              // deg axle bend at which the chain jumps off (~3 hard hits)
    "maxBendPerHit": 1.0              // deg most toe / axle bend one strike or hit adds
  },

