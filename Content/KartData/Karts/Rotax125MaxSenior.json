      "wear": { "treadDepth": 3.5, "rate": 4.0e-7, "tempDoubling": 15.0, "minGripFactor": 0.85 } // ASSUMPTION
    },
    "rear": {                         // Mojo D5 11x7.10-5 (VERIFIED size)
      "unloadedRadius": 0.1397,       // ESTIMATE: nominal 11 in diameter
      "width": 0.180,                 // ESTIMATE: nominal 7.10 in
      "spinInertia": 0.0,             // unused: rear wheels are part of rear axle inertia
      "radialStiffness": 190000.0,    // ESTIMATE
      "radialDamping": 900.0, "bodyDamping": 900.0,  // ASSUMPTION (see front tyre)
      "mu0": 1.95,                    // ASSUMPTION
      "refLoad": 460.0,               // ESTIMATE: static rear corner load
      "muLoadSensitivity": 0.07,      // ASSUMPTION
      "cxCoeff": 30,                // ASSUMPTION
      "cyCoeff": 36,                // ASSUMPTION
      "stiffnessLoadExponent": 0.8,   // ASSUMPTION
      "slideMuDrop": 0.08,            // ASSUMPTION
      "slideRefSpeed": 6.0,           // ASSUMPTION
      "relaxLengthX": 0.08,           // ASSUMPTION
      "relaxLengthY": 0.16,           // ASSUMPTION
      "rollingResistance": 0.020,     // ASSUMPTION
      "camberStiffnessRatio": 0.15,   // ASSUMPTION: car-tyre range ~0.1-0.2; no kart data
      "thermal": {
        "optimumTemp": 50.0, "tempWindow": 40.0, "minTempGripFactor": 0.92,
        "heatCapacity": 2600.0, "slideHeatFraction": 0.5,
        "convectionBase": 4.0, "convectionPerSpeed": 1.2, "trackConduction": 3.0,
        "initialTemp": 30.0
      },
      "wet": { "gripFloor": 0.60, "cooling": 8.0 },
      "pressure": { "cold": 0.60, "reference": 0.85, "carcassEquivalent": 0.5, "gasTimeConstant": 25.0 },  // cold 0.60 bar VERIFIED (Rotax MOJO D5 recommendation, +/-0.05); reference = typical hot pressure the stiffness/grip calibration applies at (ASSUMPTION); carcass share and gas lag ASSUMPTIONS
      "wear": { "treadDepth": 3.5, "rate": 4.0e-7, "tempDoubling": 15.0, "minGripFactor": 0.85 }
    }
  },

  // Wet set: Mojo W5. VERIFIED (CIK homologation 050-TW-77, rear 11x6.00-5): diameter 276 mm, tread width 125 mm,
  // tread depth 5 mm, service pressure 1.0 bar, hardness 45 IRHD (D5: 39.3), deflection under 40 kg V 2.0 / L 11.0 mm
  // (D5 rear 050-TP-45: V 1.0 / L 12.0 mm, tolerances +-2 / +-1 mm). Front 10x4.50-5 (VERIFIED size, Rotax W5 page).
  // ESTIMATE: rear width scaled by tread width (0.180 x 125/135). Radial stiffness kept = D5 (the sheet's V values do
  // not resolve a difference within +-2 mm). ASSUMPTION (no wet-tyre force data): mu0 x0.90 and slip stiffness x0.85
  // (tread-block flex) vs the slick, wet grip floor 0.85 (slick 0.60), window 35 +-30 C, wear doubling per 10 C
  // above the window (grooved blocks tear when overheated on a dry line), tread depth front 5 mm as the rear.
  "wetTyres": {
    "name": "Mojo W5 (wet)",
    "front": {
      "unloadedRadius": 0.127,
      "width": 0.114,
      "spinInertia": 0.014,
      "radialStiffness": 110000.0,
      "radialDamping": 600.0, "bodyDamping": 600.0,
      "mu0": 1.755,
      "refLoad": 330.0,
      "muLoadSensitivity": 0.16,
      "cxCoeff": 20.4,
      "cyCoeff": 22.1,
      "stiffnessLoadExponent": 0.8,
      "slideMuDrop": 0.12,
      "slideRefSpeed": 6.0,
      "relaxLengthX": 0.08,
      "relaxLengthY": 0.14,
      "rollingResistance": 0.020,
      "camberStiffnessRatio": 0.15,
      "thermal": {
        "optimumTemp": 35.0, "tempWindow": 30.0, "minTempGripFactor": 0.80,
        "heatCapacity": 1800.0, "slideHeatFraction": 0.6,
        "convectionBase": 3.0, "convectionPerSpeed": 0.9, "trackConduction": 2.0,
        "initialTemp": 30.0
      },
      "wet": { "gripFloor": 0.85, "cooling": 8.0 },
      "wear": { "treadDepth": 5.0, "rate": 4.0e-7, "tempDoubling": 10.0, "minGripFactor": 0.85 }
    },
    "rear": {
      "unloadedRadius": 0.138,
      "width": 0.167,
      "spinInertia": 0.0,
      "radialStiffness": 190000.0,
      "radialDamping": 900.0, "bodyDamping": 900.0,
      "mu0": 1.755,
      "refLoad": 460.0,
      "muLoadSensitivity": 0.07,
      "cxCoeff": 25.5,
      "cyCoeff": 30.6,
      "stiffnessLoadExponent": 0.8,
      "slideMuDrop": 0.12,
      "slideRefSpeed": 6.0,
      "relaxLengthX": 0.08,
      "relaxLengthY": 0.16,
      "rollingResistance": 0.020,
      "camberStiffnessRatio": 0.15,
      "thermal": {
