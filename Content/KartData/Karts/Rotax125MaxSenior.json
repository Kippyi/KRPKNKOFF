  "engine": {
    // WOT brake torque [rpm, Nm]. 5,000-14,000 rpm: DIGITISED from the official BRP-Rotax datasheet power graph
    // (2021_Datasheet_Senior_Printpreview.pdf, vector paths, ISO 15550 / ISO 4106 figures; +-0.2 kW reading error),
    // with the datasheet table values as anchors: 21.0 Nm @ 9000 and 18.27 Nm @ 11500 (= 22 kW) VERIFIED (the graph
    // reads 21.4 / 18.4 there, within 2 %; its 21.7 @ 8500 and 19.1 @ 11000 are trimmed so the stated maxima stay exact). Below 5,000 and above 14,000 rpm: ESTIMATE (no published data).
    "torqueCurve": [
      [ 1500,  4.0], [ 3000,  7.5], [ 4000, 10.5], [ 5000, 13.1], [ 5500, 13.6], [ 6000, 14.1],
      [ 6500, 15.1], [ 7000, 17.1], [ 7500, 18.8], [ 8000, 20.4], [ 8500, 20.9], [ 9000, 21.0],
      [ 9500, 20.7], [10000, 20.1], [10500, 19.5], [11000, 19.0], [11500, 18.27], [12000, 15.6],
      [12500, 12.4], [13000,  8.6], [13500,  8.5], [14000,  9.0], [14500,  7.0], [15000,  5.0]
    ],
    "inertia": 0.0030,                // ASSUMPTION: needs measurement
