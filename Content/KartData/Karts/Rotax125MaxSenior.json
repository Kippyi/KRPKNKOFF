  // Engine tuning / condition (EngineTune.h). Carb: Dellorto VHSB 34 XS (VERIFIED, Rotax operating manual), needle
  // standard clip position 2 (VERIFIED, same manual). Main jet vs temperature: RADNE's EVO table (third party) 122 at
  // >= 18 degC, 125 below 18, 128 below 10 -> best jet 122 at the 22 degC reference; density exponent 0.70 reproduces
  // those steps and the IAME "+2-3 points per 6 degC" rule (ESTIMATE). Water window 50-55 degC (AiM sensor guide for
  // Rotax). Radiator on the left of the seat. Heat / cooling / piston numbers: ESTIMATES / ASSUMPTIONS.
  "tuning": {
    "carb": "mainJet",
    "jet": 122, "jetMin": 110, "jetMax": 140, "jetStep": 1,
    "bestJetRef": 122, "refAirTemp": 22.0, "refPressure": 101.325, "refHumidity": 0.5,
    "jetDensityExponent": 0.70, "flowExponent": 2.0,
    "cooling": {
      "type": "water", "cover": 0.0, "heatCapacity": 9000.0, "heatPerPower": 1.1, "idleHeat": 600.0,
      "base": 35.0, "perSpeed": 20.5, "optimumLow": 50.0, "optimumHigh": 55.0,
      "powerPerDegCold": 0.0015, "powerPerDegHot": 0.002, "warmTemp": 50.0
    },
    "piston": { "rise": 200.0, "limit": 275.0, "timeConstant": 3.0, "leanHeat": 4.0, "seizeRate": 0.033,
