      "unloadedRadius": 0.127,        // ESTIMATE: nominal 10 in diameter
      "width": 0.114,                 // ESTIMATE: nominal 4.50 in
      "spinInertia": 0.014,           // ESTIMATE
      "radialStiffness": 110000.0,    // ESTIMATE: contact-area/pressure derivation at 0.6 bar
      "radialDamping": 600.0, "bodyDamping": 600.0,  // ASSUMPTION: bodyDamping = the seated driver's damping, acting on the wheel's own vertical motion only (not on road bumps). Added after user telemetry 2026-11-17 showed KZ pogo-hopping at ~10 % critical damping.
      "mu0": 1.95,                    // ASSUMPTION: needs tyre data
      "refLoad": 330.0,               // ESTIMATE: static front corner load
      "muLoadSensitivity": 0.16,      // ASSUMPTION
      "cxCoeff": 24,                // ASSUMPTION
      "cyCoeff": 26,                // ASSUMPTION
      "stiffnessLoadExponent": 0.8,   // ASSUMPTION
      "slideMuDrop": 0.08,            // ASSUMPTION
      "slideRefSpeed": 6.0,           // ASSUMPTION
      "relaxLengthX": 0.08,           // ASSUMPTION
      "relaxLengthY": 0.14,           // ASSUMPTION
      "rollingResistance": 0.020,     // ASSUMPTION
      "camberStiffnessRatio": 0.15,   // ASSUMPTION: car-tyre range ~0.1-0.2; no kart data
      "thermal": {
