    "inertia": [17.5, 23.7, 31.6],    // ESTIMATE: Rotax baseline scaled by mass 160/162
    // Frame torsion (Milestone 3 chain model, lumped configuration): front section | body (all mass at the
    // CoG) | rear section, joined by springs in series. Equivalent to the validated Milestone 2 two-section
    // model; inertia[0] = sum of node roll inertias. A distributed-mass variant is in the research config.
    "frame": {
      "nodes": [[0.0, 1.2, 14.0, 0.27], [0.6077, 13.8, 128.0, 0.27], [1.04, 2.5, 18.0, 0.27]],
      "segmentStiffness": [36000.0, 36000.0],   // equal split of the 18000 Nm/rad frame (ASSUMPTION, validated for drivability)
      "segmentDamping": [120.0, 150.0],          // ASSUMPTION
      // Vertical bending (Milestone 9). EI: two 30 x 2 mm main rails (VERIFIED common CIK tube size, 2 x 3640 N m^2) x 1.5
      // for the seat, its stays and the floor tray stiffening the middle (ASSUMPTION). Node masses: wheel assemblies,
      // stub axles, nose and pedals at the front axle; axle, hubs, wheels, sprocket, disc and bumper at the rear axle;
      // driver, seat, engine and tank on the body node (ESTIMATES; all at CoG height, so the twist model is unchanged).
      "bendingEI": 10900.0,
      "bendingDampingRatio": 0.15,      // ASSUMPTION: mostly the driver's body in the seat
      "torsionalStiffness": 18000.0,
      "torsionalDamping": 70.0          // ASSUMPTION
    },
    "twistAxisHeight": 0.10,          // ESTIMATE
