        "camberInertia": 0.012,       // ESTIMATE: kg m^2 about the longitudinal axis
        "tubeOuterDiameter": 0.025,   // ESTIMATE: 25 mm stub axle (common CIK spindle), solid
        "tubeWall": 0.0,
        "freeSpan": 0.07,             // ESTIMATE: spindle to the hub bearings' load centre
        "dampingRatio": 0.03          // ASSUMPTION
      },
      "rear": {
        "unsprungMass": 3.2,          // ESTIMATE: rim ~1.1 + tyre ~1.5 + 50 mm hub ~0.6 (kg)
        "camberInertia": 0.022,       // ESTIMATE
        "tubeOuterDiameter": 0.050,   // VERIFIED: 50 mm senior axle
        "tubeWall": 0.002,            // VERIFIED typical (1.6 / 2.0 / 2.5 mm axles are sold); setup rearAxleWall
        "youngsModulus": 2.1e11,      // VERIFIED: steel (heat treatment / 'hardness' grade barely changes it)
        "bearingY": 0.33,             // ASSUMPTION: outer bearing carriers on the main rails (no published spacing found)
        "hubLength": 0.110,           // ESTIMATE: within the common 70-150 mm range; setup rearHubLength
        "hubToWheelCentre": 0.04,     // ESTIMATE: hub face to the centre of the rim
        "dampingRatio": 0.03          // ASSUMPTION
      }
